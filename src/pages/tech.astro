---
import { Image } from "astro:assets"
import CommonLayout from "@/layouts/CommonLayout.astro"
import Section from "@/components/layout/Section.astro"
import TechStack from "@/components/projects/TechStack.astro"
import techStack from "@/content/tech-stack.json"
import ToolSection from "@/components/tools/ToolSection.astro"
import { ToolTag } from "@/components/tools/tags"
import Badge from "@/components/base/Badge.astro"

import certGoogle from "@/assets/google_data_analytics.png"
import certPython from "@/assets/python_for_everybody.png"
import certPostgres from "@/assets/postgresql_for_everybody.png"

const usesDescription =
  "A collection of certificates, tools, platforms, and languages I use on a frequent basis for data analysis, engineering, and visualization."
---

<CommonLayout
  title="Tech & Tools"
  description={usesDescription}
  modifiedTime={new Date()}
  breadcrumbs={[{ label: "Tech", icon: "tool" }]}
  prose={false}
>
  <!-- 1. Certificates -->
  <Section title="Certificates" class="certificates-section">
    <div class="cert-grid">
      <div class="cert-card">
        <div class="cert-image-wrapper">
          <Image
            src={certGoogle}
            alt="Google Data Analytics Professional Certificate"
            width={400}
          />
        </div>
        <div class="cert-tags">
          <Badge variant="outline">Data Analysis</Badge>
          <Badge variant="outline">SQL</Badge>
        </div>
      </div>

      <div class="cert-card">
        <div class="cert-image-wrapper">
          <Image
            src={certPython}
            alt="Python for Everybody Certificate"
            width={400}
          />
        </div>
        <div class="cert-tags">
          <Badge variant="outline">Python</Badge>
          <Badge variant="outline">Data Structures</Badge>
        </div>
      </div>

      <div class="cert-card">
        <div class="cert-image-wrapper">
          <Image
            src={certPostgres}
            alt="PostgreSQL for Everybody Certificate"
            width={400}
          />
        </div>
        <div class="cert-tags">
          <Badge variant="outline">PostgreSQL</Badge>
          <Badge variant="outline">Database Design</Badge>
        </div>
      </div>
    </div>
  </Section>

  <!-- 2. Tech Stack -->
  <Section title="Tech Stack" class="tech-stack-section">
    <TechStack {...techStack} />
  </Section>

  <!-- 3. Languages -->
  <ToolSection
    title="Languages"
    tools={[
      {
        name: "Python",
        description: "Core Programming Language",
        href: "https://www.python.org/",
        icon: "mingcute:code-line",
        tags: [ToolTag.OpenSource, ToolTag.Favorite],
      },
      {
        name: "SQL",
        description: "Database Query Language",
        href: "#",
        icon: "mingcute:code-line",
      },
      {
        name: "R",
        description: "Statistical Computing",
        href: "https://www.r-project.org/",
        icon: "mingcute:code-line",
        tags: [ToolTag.OpenSource],
      },
      {
        name: "LaTeX",
        description: "Document Preparation",
        href: "https://www.latex-project.org/",
        icon: "mingcute:code-line",
      },
      {
        name: "Markdown",
        description: "Markup Language",
        href: "#",
        icon: "mingcute:code-line",
      },
    ]}
  />

  <!-- 4. Data Engineering & Databases -->
  <ToolSection
    title="Data Engineering & Databases"
    tools={[
      {
        name: "PostgreSQL",
        description: "Relational Database",
        href: "https://www.postgresql.org/",
        icon: "mingcute:code-line",
        tags: [ToolTag.OpenSource, ToolTag.Favorite],
      },
      {
        name: "MySQL",
        description: "Relational Database",
        href: "https://www.mysql.com/",
        icon: "mingcute:code-line",
      },
      {
        name: "SQLite",
        description: "Embedded Database",
        href: "https://www.sqlite.org/",
        icon: "mingcute:code-line",
      },
      {
        name: "ETL & Data Pipelines",
        description: "Data Integration workflows",
        href: "#",
        icon: "mingcute:code-line",
      },
      {
        name: "Web Scraping",
        description: "Automated Data Extractors",
        href: "#",
        icon: "mingcute:code-line",
      },
      {
        name: "BeautifulSoup",
        description: "HTML Parsing Library",
        href: "https://www.crummy.com/software/BeautifulSoup/",
        icon: "mingcute:code-line",
      },
      {
        name: "REST APIs",
        description: "Application Programming Interfaces",
        href: "#",
        icon: "mingcute:code-line",
      },
      {
        name: "JSON & XML",
        description: "Data Formats",
        href: "#",
        icon: "mingcute:code-line",
      },
    ]}
  />

  <!-- 5. Data Analysis & Processing -->
  <ToolSection
    title="Data Analysis & Processing"
    tools={[
      {
        name: "Pandas",
        description: "Data Manipulation Library",
        href: "https://pandas.pydata.org/",
        icon: "mingcute:code-line",
        tags: [ToolTag.OpenSource, ToolTag.Favorite],
      },
      {
        name: "NumPy",
        description: "Numerical Computing",
        href: "https://numpy.org/",
        icon: "mingcute:code-line",
      },
      {
        name: "SciPy",
        description: "Scientific Computing",
        href: "https://scipy.org/",
        icon: "mingcute:code-line",
      },
      {
        name: "Data Cleaning",
        description: "Data Wrangling & Processing",
        href: "#",
        icon: "mingcute:code-line",
      },
      {
        name: "Spreadsheets",
        description: "Excel & Google Sheets",
        href: "#",
        icon: "mingcute:code-line",
      },
      {
        name: "Geospatial Analysis",
        description: "Spatial Data & Mapping",
        href: "#",
        icon: "mingcute:code-line",
      },
    ]}
  />

  <!-- 6. Data Visualization & BI -->
  <ToolSection
    title="Data Visualization & BI"
    tools={[
      {
        name: "Apache Superset",
        description: "Data Exploration Platform",
        href: "https://superset.apache.org/",
        icon: "mingcute:code-line",
        tags: [ToolTag.OpenSource, ToolTag.Favorite],
      },
      {
        name: "Power BI",
        description: "Business Intelligence",
        href: "https://powerbi.microsoft.com/",
        icon: "mingcute:code-line",
      },
      {
        name: "Tableau",
        description: "Visual Analytics",
        href: "https://www.tableau.com/",
        icon: "mingcute:code-line",
      },
      {
        name: "Metabase",
        description: "Business Intelligence",
        href: "https://www.metabase.com/",
        icon: "mingcute:code-line",
      },
      {
        name: "Streamlit",
        description: "Data Web Apps",
        href: "https://streamlit.io/",
        icon: "mingcute:code-line",
      },
      {
        name: "Plotly",
        description: "Interactive Charts",
        href: "https://plotly.com/",
        icon: "mingcute:code-line",
      },
      {
        name: "Matplotlib & Seaborn",
        description: "Static Data Plotting",
        href: "#",
        icon: "mingcute:code-line",
      },
      {
        name: "Presentations",
        description: "Data Storytelling",
        href: "#",
        icon: "mingcute:code-line",
      },
    ]}
  />

  <!-- 7. AI & ML -->
  <ToolSection
    title="AI & ML"
    tools={[
      {
        name: "Artificial Intelligence",
        description: "AI Concepts & Implementations",
        href: "#",
        icon: "mingcute:code-line",
      },
      {
        name: "Prompt Engineering",
        description: "LLM Interaction Optimization",
        href: "#",
        icon: "mingcute:code-line",
      },
      {
        name: "AI Project Management",
        description: "Managing AI-driven workflows",
        href: "#",
        icon: "mingcute:code-line",
      },
      {
        name: "Local LLMs",
        description: "Ollama, GPT4All",
        href: "#",
        icon: "mingcute:code-line",
        tags: [ToolTag.OpenSource],
      },
    ]}
  />

  <!-- 8. Tools & Infrastructure -->
  <ToolSection
    title="Tools & Infrastructure"
    tools={[
      {
        name: "Ubuntu",
        description: "Linux Operating System",
        href: "https://ubuntu.com/",
        icon: "mingcute:code-line",
        tags: [ToolTag.OpenSource],
      },
      {
        name: "Git & GitHub",
        description: "Version Control",
        href: "https://github.com/",
        icon: "mingcute:code-line",
      },
      {
        name: "DBeaver",
        description: "Universal Database Tool",
        href: "https://dbeaver.io/",
        icon: "mingcute:code-line",
      },
      {
        name: "Astro",
        description: "Web Framework",
        href: "https://astro.build/",
        icon: "mingcute:code-line",
      },
    ]}
  />
</CommonLayout>

<style>
  .certificates-section,
  .tech-stack-section {
    margin-block-end: var(--space-xl);
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-m);
  }

  .cert-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-s);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--background);
  }

  .cert-image-wrapper {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .cert-image-wrapper img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .cert-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin-block-start: auto;
  }
</style>
