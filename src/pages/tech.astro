---
import { Image } from "astro:assets"
import CommonLayout from "@/layouts/CommonLayout.astro"
import Section from "@/components/layout/Section.astro"
import TechStack from "@/components/projects/TechStack.astro"
import techStack from "@/content/tech-stack.json"
import ToolSection from "@/components/tools/ToolSection.astro"
import { ToolTag } from "@/components/tools/tags"
import Badge from "@/components/base/Badge.astro"

import certGoogle from "@/assets/google_data_analytics.png"
import certPython from "@/assets/python_for_everybody.png"
import certPostgres from "@/assets/postgresql_for_everybody.png"

const usesDescription =
  "A collection of certificates, tools, platforms, and languages I use on a frequent basis for data analysis, engineering, and visualization."
---

<CommonLayout
  title="Tech & Tools"
  description={usesDescription}
  modifiedTime={new Date()}
  breadcrumbs={[{ label: "Tech", icon: "tool" }]}
  prose={false}
>
  <!-- 1. Certificates -->
  <Section title="Certificates" class="certificates-section">
    <div class="cert-grid">
      <div class="cert-card">
        <div class="cert-image-wrapper">
          <Image
            src={certGoogle}
            alt="Google Data Analytics Professional Certificate"
            width={400}
          />
        </div>
        <div class="cert-tags">
          <Badge variant="outline">Data Analysis</Badge>
          <Badge variant="outline">SQL</Badge>
        </div>
      </div>

      <div class="cert-card">
        <div class="cert-image-wrapper">
          <Image
            src={certPython}
            alt="Python for Everybody Certificate"
            width={400}
          />
        </div>
        <div class="cert-tags">
          <Badge variant="outline">Python</Badge>
          <Badge variant="outline">Data Structures</Badge>
        </div>
      </div>

      <div class="cert-card">
        <div class="cert-image-wrapper">
          <Image
            src={certPostgres}
            alt="PostgreSQL for Everybody Certificate"
            width={400}
          />
        </div>
        <div class="cert-tags">
          <Badge variant="outline">PostgreSQL</Badge>
          <Badge variant="outline">Database Design</Badge>
        </div>
      </div>
    </div>
  </Section>

  <!-- 2. Tech Stack -->
  <Section title="Tech Stack" class="tech-stack-section">
    <TechStack {...techStack} />
  </Section>

  <!-- 3. Workstation & Cloud Platforms -->
  <ToolSection
    title="Workstation & Cloud Platforms"
    tools={[
      {
        name: "Ubuntu",
        description: "Operating System",
        href: "https://ubuntu.com/",
        icon: "logos:ubuntu",
        tags: [ToolTag.OpenSource],
      },
      {
        name: "AWS",
        description: "Cloud Computing",
        href: "https://aws.amazon.com/",
        icon: "logos:aws",
      },
      {
        name: "Azure",
        description: "Cloud Platform",
        href: "https://azure.microsoft.com/",
        icon: "logos:microsoft-azure",
      },
    ]}
  />

  <!-- 4. Languages & Development -->
  <ToolSection
    title="Languages & Development"
    tools={[
      {
        name: "Python",
        description: "Programming Language",
        href: "https://www.python.org/",
        icon: "logos:python",
        tags: [ToolTag.OpenSource, ToolTag.Favorite],
      },
      {
        name: "R",
        description: "Statistical Computing",
        href: "https://www.r-project.org/",
        icon: "devicon:r",
        tags: [ToolTag.OpenSource],
      },
      {
        name: "VS Code",
        description: "IDE",
        href: "https://code.visualstudio.com/",
        icon: "logos:visual-studio-code",
        tags: [ToolTag.Free, ToolTag.Favorite],
      },
      {
        name: "Jupyter Notebook",
        description: "Interactive Computing",
        href: "https://jupyter.org/",
        icon: "logos:jupyter",
        tags: [ToolTag.OpenSource],
      },
    ]}
  />

  <!-- 5. Data Engineering & Databases -->
  <ToolSection
    title="Data Engineering & Databases"
    tools={[
      {
        name: "Databricks",
        description: "Unified Data Analytics",
        href: "https://databricks.com/",
        icon: "devicon:databricks",
      },
      {
        name: "Openquery",
        description: "Database Querying",
        href: "#",
        icon: "vscode-icons:file-type-sql",
      },
    ]}
  />

  <!-- 6. Business Intelligence & Visualization -->
  <ToolSection
    title="Business Intelligence & Visualization"
    tools={[
      {
        name: "Apache Superset",
        description: "Data Exploration",
        href: "https://superset.apache.org/",
        icon: "logos:superset-icon",
        tags: [ToolTag.OpenSource, ToolTag.Favorite],
      },
      {
        name: "Metabase",
        description: "Business Intelligence",
        href: "https://www.metabase.com/",
        icon: "logos:metabase",
        tags: [ToolTag.OpenSource],
      },
      {
        name: "Power BI",
        description: "Interactive Visualization",
        href: "https://powerbi.microsoft.com/",
        icon: "logos:microsoft-power-bi",
      },
      {
        name: "Tableau",
        description: "Visual Analytics",
        href: "https://www.tableau.com/",
        icon: "logos:tableau-icon",
      },
    ]}
  />

  <!-- 7. AI, Research & Productivity -->
  <ToolSection
    title="AI, Research & Productivity"
    tools={[
      {
        name: "Gemini",
        description: "AI Assistant",
        href: "https://gemini.google.com/",
        icon: "logos:google-gemini",
      },
      {
        name: "Kaggle",
        description: "Data Science Community",
        href: "https://www.kaggle.com/",
        icon: "logos:kaggle",
        tags: [ToolTag.Free],
      },
      {
        name: "Excel",
        description: "Spreadsheet",
        href: "https://www.microsoft.com/excel",
        icon: "vscode-icons:file-type-excel",
      },
      {
        name: "Google Sheets",
        description: "Online Spreadsheet",
        href: "https://sheets.google.com/",
        icon: "logos:google-icon",
        tags: [ToolTag.Free],
      },
      {
        name: "Google Slides",
        description: "Presentations",
        href: "https://slides.google.com/",
        icon: "logos:google-icon",
        tags: [ToolTag.Free],
      },
    ]}
  />
</CommonLayout>

<style>
  .certificates-section,
  .tech-stack-section {
    margin-block-end: var(--space-xl);
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-m);
  }

  .cert-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-s);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--background);
  }

  .cert-image-wrapper {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .cert-image-wrapper img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .cert-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin-block-start: auto;
  }
</style>
